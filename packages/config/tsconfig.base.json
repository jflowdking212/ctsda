{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@ctsda/contracts": ["../../packages/contracts/src"],
      "@ctsda/contracts/*": ["../../packages/contracts/src/*"],
      "@ctsda/db": ["../../packages/db/src"],
      "@ctsda/db/*": ["../../packages/db/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "build"]
}