# Database
DATABASE_URL="postgresql://ctsda:ctsda_dev_password@localhost:5432/ctsda"
ADMIN_EMAIL="admin@ctsda.org"
ADMIN_PASSWORD=""

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO (S3-compatible storage)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="ctsda_admin"
MINIO_SECRET_KEY="ctsda_minio_password"
MINIO_BUCKET="ctsda-documents"
MINIO_USE_SSL="false"

# Session
SESSION_SECRET="change-this-to-a-random-64-char-string"
SESSION_TTL_SECONDS=86400

# Argon2
ARGON2_SECRET="change-this-to-a-random-pepper-string"

# TOTP
TOTP_ISSUER="CTSDA"

# Email (SMTP)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@ctsda.org"

# Payment Provider (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CURRENCY="usd"

# Frontend URL (for CORS, redirects)
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:4000"

# Logging
LOG_LEVEL="debug"
